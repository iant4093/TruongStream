{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Capabilities of the TruongStream Studio window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-unminimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-set-fullscreen",
    "core:window:allow-is-fullscreen",
    "core:window:allow-close",
    "core:window:allow-hide",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "dialog:default",
    "dialog:allow-open",
    "updater:default",
    "process:allow-restart",
    "allow-list-cameras",
    "allow-connect-camera",
    "allow-disconnect-camera",
    "allow-start-stream",
    "allow-stop-stream",
    "allow-get-latest-frame",
    "allow-set-camera-property",
    "allow-trigger-autofocus",
    "allow-drive-focus",
    "allow-set-lut-config",
    "allow-set-split-preview",
    "allow-set-system-config",
    "allow-get-telemetry",
    "allow-activate-camera-extension",
    "allow-update-feed-status",
    "allow-runtime-shutdown-for-update"
  ]
}
